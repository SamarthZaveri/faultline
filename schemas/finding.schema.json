{
  "$defs": {
    "Category": {
      "enum": [
        "data",
        "pipeline"
      ],
      "title": "Category",
      "type": "string"
    },
    "Complexity": {
      "enum": [
        "tier1",
        "tier2",
        "unknown"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "Environment": {
      "enum": [
        "preprod",
        "prod"
      ],
      "title": "Environment",
      "type": "string"
    },
    "Evidence": {
      "properties": {
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "samples": {
          "items": {
            "type": "string"
          },
          "title": "Samples",
          "type": "array"
        },
        "code_snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Snippet"
        }
      },
      "required": [
        "explanation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "detected",
        "triaged",
        "fix_pr_open",
        "fixed",
        "escalated",
        "resolved",
        "false_positive",
        "suppressed"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Location": {
      "properties": {
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SuggestedFix": {
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "diff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diff"
        },
        "check_spec": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Spec"
        }
      },
      "required": [
        "description"
      ],
      "title": "SuggestedFix",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "environment": {
      "$ref": "#/$defs/Environment",
      "default": "preprod"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "suggested_fix": {
      "anyOf": [
        {
          "$ref": "#/$defs/SuggestedFix"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "complexity": {
      "$ref": "#/$defs/Complexity",
      "default": "unknown"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus",
      "default": "detected"
    },
    "detector": {
      "title": "Detector",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "refs": {
      "items": {
        "type": "string"
      },
      "title": "Refs",
      "type": "array"
    }
  },
  "required": [
    "type",
    "title",
    "severity",
    "confidence",
    "category",
    "location",
    "evidence",
    "detector"
  ],
  "title": "Finding",
  "type": "object"
}
